# Google Sheets / Drive（npm run sync で使う。§10-sync-spec.md）
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
# フォームの回答が入っているタブ名。実物に合わせる（npm run sync -- --list-sheets で確認できる）。
# Googleフォームの既定は「フォームの回答 1」だが、改名されていることがある。
SHEET_NAME=Form Responses 1
DRIVE_FOLDER_ID=

# sync の認証。サービスアカウントを偽装して Sheets を読む。
# 組織ポリシーでキーが作れず、gcloud 既定クライアントの同意画面もブロックされるため、
# キーも同意画面も使わないこの方式を既定にしている。
# 事前に `gcloud auth application-default login`（--scopes は付けない）が要る。
IMPERSONATE_SERVICE_ACCOUNT=

# 1 のときだけ「確認中」の団体をビルドに含める。
# Vercel の preview ブランチにだけ設定する。本番には設定しない。
INCLUDE_UNCONFIRMED=

# 1 のときだけ検索エンジンに載せる（robots.txt を開き、noindex を外す）。
# 未設定・空 = 全ページ noindex, nofollow。**公開前はこのまま空にしておく。**
# INCLUDE_UNCONFIRMED とは別物で、外す時期も違う。
# 本番データが揃って一般公開するときに、本番環境にだけ 1 を設定する。
# 静的生成なので、変更後は再デプロイが要る。
ALLOW_INDEXING=
