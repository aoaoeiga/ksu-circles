# Google Sheets / Drive（npm run sync で使う。§10-sync-spec.md）
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
SHEET_NAME=フォームの回答 1
DRIVE_FOLDER_ID=

# 1 のときだけ「確認中」の団体をビルドに含める。
# Vercel の preview ブランチにだけ設定する。本番には設定しない。
INCLUDE_UNCONFIRMED=

# 1 のときだけ検索エンジンに載せる（robots.txt を開き、noindex を外す）。
# 未設定・空 = 全ページ noindex, nofollow。**公開前はこのまま空にしておく。**
# INCLUDE_UNCONFIRMED とは別物で、外す時期も違う。
# 本番データが揃って一般公開するときに、本番環境にだけ 1 を設定する。
# 静的生成なので、変更後は再デプロイが要る。
ALLOW_INDEXING=
